# =============================================================================
# BusinessFlow AI — Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# For Vercel: add each variable in the Vercel dashboard under
# Project Settings → Environment Variables.
# Separate values for Preview and Production environments.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC / BROWSER-SAFE VARIABLES (prefixed with NEXT_PUBLIC_)
# These are embedded in the client bundle. Do NOT put secrets here.
# -----------------------------------------------------------------------------

# Canonical application URL (used for auth callbacks, password recovery links, invitations)
# Local: http://localhost:3000
# Preview: https://your-preview.vercel.app
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Supabase project URL (public)
# Get from: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (anon/public key)
# Get from: Supabase Dashboard → Settings → API → Project API keys → anon/public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS
# These must NEVER be prefixed with NEXT_PUBLIC_ and must NEVER be exposed
# to the browser. Only available in server-side code (API routes, server actions,
# middleware, server components).
# -----------------------------------------------------------------------------

# PostgreSQL connection used by Prisma at runtime (session pooler, port 6543)
# Get from: Supabase Dashboard → Settings → Database → Connection pooling → Session pooler
# Format: postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# PostgreSQL connection used by Prisma CLI for migrations (direct connection, port 5432)
# Get from: Supabase Dashboard → Settings → Database → Connection pooling → Direct connection
# Format: postgresql://postgres.<ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# Supabase service-role key (secret, full admin access)
# Get from: Supabase Dashboard → Settings → API → Project API keys → service_role
# Used for: private storage operations, admin auth APIs, invitation emails
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# AI / GEMINI CONFIGURATION (server-only)
# -----------------------------------------------------------------------------

# Google Gemini API key
# Get from: Google AI Studio → Get API key
GEMINI_API_KEY=

# Gemini model name for AI Project Intelligence and Assistant
# Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# AI provider (currently only gemini is supported)
AI_PROVIDER=gemini

# -----------------------------------------------------------------------------
# OPTIONAL CONFIGURATION
# -----------------------------------------------------------------------------

# Workspace invitation link lifetime in days (1-90)
# Default: 7
WORKSPACE_INVITATION_EXPIRY_DAYS=7

# Explicitly enable seed data in non-development environments
# DANGEROUS: Only set to "true" for controlled test/staging databases.
# Production deployments MUST NOT set this.
SEED_DATA_ENABLED=false

# Enable demo mode (demo sign-in, disposable sandbox, reset endpoint)
# Default: false — set to "true" to activate demo features
DEMO_MODE_ENABLED=false