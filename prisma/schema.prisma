generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  LOST
  WON
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_STATUS_CHANGED
  LEAD_CONVERTED
  LEAD_DELETED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_STATUS_CHANGED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_STATUS_CHANGED
  PROJECT_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_DELETED
  DOCUMENT_CREATED
  DOCUMENT_DELETED
  DOCUMENT_PRIMARY_SET
  PROJECT_AI_ANALYZED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectDocumentType {
  PROJECT_BRIEF
  CLIENT_ASSET
  REFERENCE
  DESIGN
  DELIVERABLE
  OTHER
}

enum ProjectAIAnalysisStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AIAnalysisFeedbackTargetType {
  ANALYSIS
  SUMMARY
  REQUIREMENT
  DELIVERABLE
  RISK
  MISSING_INFORMATION
  SUGGESTED_TASK
}

enum AIAnalysisFeedbackType {
  INCORRECT
  MISSING_INFORMATION
  NOT_RELEVANT
  DUPLICATE
  NOT_ACTIONABLE
  TOO_GENERIC
  OTHER
}

enum AIConversationMessageRole {
  USER
  ASSISTANT
}

model User {
  id              String               @id @default(cuid())
  authUserId      String               @unique
  name            String
  email           String               @unique
  avatarUrl       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  memberships     OrganizationMember[]
  activities      Activity[]
  createdLeads    Lead[]
  createdProjects Project[]
  createdTasks    Task[]               @relation("TaskCreatedBy")
  assignedTasks   Task[]               @relation("TaskAssignee")
  uploadedDocuments ProjectDocument[]
  approvedAiSuggestions AISuggestedTaskApproval[]
  aiAnalysisFeedback AIAnalysisFeedback[]
  aiConversations   AIConversation[]
}

model Organization {
  id           String               @id @default(cuid())
  name         String
  businessType String               @default("OTHER")
  slug         String               @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]
  leads        Lead[]
  clients      Client[]
  projects     Project[]
  tasks        Task[]
  documents    ProjectDocument[]
  aiAnalyses   ProjectAIAnalysis[]
  aiTaskApprovals AISuggestedTaskApproval[]
  aiAnalysisFeedback AIAnalysisFeedback[]
  aiConversations AIConversation[]
  activities   Activity[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String
  phone          String?
  company        String?
  source         String
  notes          String?
  status         LeadStatus   @default(NEW)
  estimatedValue Decimal?     @db.Decimal(12, 2)
  currency       String       @default("USD")
  createdById    String?
  convertedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  client         Client?
  activities     Activity[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

model Client {
  id             String       @id @default(cuid())
  organizationId String
  leadId         String?      @unique
  name           String
  email          String?
  phone          String?
  company        String?
  notes          String?
  status         ClientStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [organizationId, leadId], references: [organizationId, id], onDelete: Restrict)
  projects       Project[]
  activities     Activity[]

  @@unique([organizationId, leadId])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
}

model Project {
  id             String          @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  description    String?
  status         ProjectStatus   @default(PLANNING)
  priority       ProjectPriority @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  notes          String?
  createdById    String?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  createdBy      User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks          Task[]
  documents      ProjectDocument[]
  aiAnalyses     ProjectAIAnalysis[]
  aiTaskApprovals AISuggestedTaskApproval[]
  aiAnalysisFeedback AIAnalysisFeedback[]
  activities     Activity[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, clientId])
  @@index([organizationId, dueDate])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  assigneeId     String?
  createdById    String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activities     Activity[]
  aiSuggestionApproval AISuggestedTaskApproval?

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, projectId])
  @@index([organizationId, dueDate])
  @@index([assigneeId])
}

model ProjectDocument {
  id             String               @id @default(cuid())
  organizationId String
  projectId      String
  uploadedById   String?
  name           String
  originalName   String
  documentType   ProjectDocumentType @default(OTHER)
  mimeType       String?
  sizeBytes      Int?
  storagePath    String?
  storageUrl     String?
  isPrimary      Boolean             @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project              @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy     User?                @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  aiAnalyses     ProjectAIAnalysis[]

  @@unique([organizationId, id])
  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId])
  @@index([organizationId, projectId, documentType])
  @@index([projectId])
}

model ProjectAIAnalysis {
  id                       String                  @id @default(cuid())
  organizationId           String
  projectId                String
  sourceDocumentId         String?
  sourceDocumentName       String
  sourceDocumentUpdatedAt  DateTime
  status                   ProjectAIAnalysisStatus @default(PROCESSING)
  result                   Json?
  errorCode                String?
  model                    String
  analysisVersion          Int                     @default(1)
  completedAt              DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  organization             Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project                  Project                 @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  sourceDocument           ProjectDocument?        @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  suggestionApprovals      AISuggestedTaskApproval[]
  feedback                 AIAnalysisFeedback[]

  @@unique([organizationId, projectId, id])
  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, projectId, sourceDocumentId])
  @@index([status, updatedAt])
}

model AISuggestedTaskApproval {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String
  analysisId     String
  suggestionId   String
  taskId         String?           @unique
  approvedById   String
  approvedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  analysis       ProjectAIAnalysis @relation(fields: [organizationId, projectId, analysisId], references: [organizationId, projectId, id], onDelete: Cascade)
  task           Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  approvedBy     User              @relation(fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([analysisId, suggestionId])
  @@index([organizationId, projectId, approvedAt])
}

model AIAnalysisFeedback {
  id             String                       @id @default(cuid())
  organizationId String
  projectId      String
  analysisId     String
  targetType     AIAnalysisFeedbackTargetType
  targetId       String
  feedbackType   AIAnalysisFeedbackType
  comment        String?
  createdById    String
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project                      @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Cascade)
  analysis       ProjectAIAnalysis            @relation(fields: [organizationId, projectId, analysisId], references: [organizationId, projectId, id], onDelete: Cascade)
  createdBy      User                         @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, analysisId, targetType, targetId, createdById], map: "AIAnalysisFeedback_user_target_key")
  @@index([organizationId, projectId, analysisId, createdAt])
  @@index([createdById])
}

model AIConversation {
  id               String                 @id @default(cuid())
  organizationId   String
  createdById      String
  title            String                 @default("New conversation")
  contextProjectId String?
  memorySummary    String?
  memoryUpdatedAt  DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy        User                   @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages         AIConversationMessage[]

  @@index([organizationId, createdById, updatedAt])
}

model AIConversationMessage {
  id                String                   @id @default(cuid())
  conversationId    String
  role              AIConversationMessageRole
  content           String                   @db.Text
  requestId         String?
  replyToMessageId  String?                  @unique
  createdAt         DateTime                 @default(now())
  conversation      AIConversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo           AIConversationMessage?    @relation("AIConversationMessageReply", fields: [replyToMessageId], references: [id], onDelete: Cascade)
  reply             AIConversationMessage?    @relation("AIConversationMessageReply")

  @@unique([conversationId, requestId])
  @@index([conversationId, createdAt])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String
  leadId         String?
  clientId       String?
  projectId      String?
  taskId         String?
  type           ActivityType
  description    String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task           Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([projectId])
  @@index([taskId])
}
